# Google Analytics 4 Measurement ID (e.g. G-XXXXXXX).
# Create a GA4 property at https://analytics.google.com to get one.
# Leave unset locally to develop without GA loaded.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Canonical production URL, used for SEO metadata, sitemap.xml, and robots.txt.
# Only needed if a custom domain replaces the default in src/lib/constants.ts
# (currently https://radiusgame.netlify.app).
NEXT_PUBLIC_SITE_URL=
